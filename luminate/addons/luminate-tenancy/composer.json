{
  "name": "luminate/tenancy",
  "description": "Luminate pooled-tenancy add-on for Wellms: signed tenant-context token, RLS, per-tenant cache/queue/storage. No core patches.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1",
    "illuminate/http": "^9.0|^10.0",
    "illuminate/support": "^9.0|^10.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": { "psr-4": { "Luminate\\Tenancy\\": "src/" } },
  "autoload-dev": { "psr-4": { "Luminate\\Tenancy\\Tests\\": "tests/" } },
  "extra": { "laravel": { "providers": [ "Luminate\\Tenancy\\TenancyServiceProvider" ] } },
  "config": { "sort-packages": true }
}
