# Template only. `pwsh ./bootstrap.ps1` writes .env (git-ignored) with generated secrets.
# Dev environment, fake data only.
# Local dev includes docker-compose.dev.yml (Swagger without a tenant token + test fixtures). REMOVE both lines for a
# production-like run, which is simply: docker compose -f docker-compose.yml up -d
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
COMPOSE_PATH_SEPARATOR=;

LAN_HOST=
BIND_ADDR=0.0.0.0
API_PORT=8080
S3_PORT=9000

APP_KEY=

DB_NAME=wellms
DB_BOOTSTRAP_USER=db_bootstrap
DB_BOOTSTRAP_PASSWORD=
DB_OWNER_USER=wellms_owner
DB_OWNER_PASSWORD=
DB_APP_USER=wellms_app
DB_APP_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=minio_root
MINIO_ROOT_PASSWORD=
S3_BUCKET=wellms
S3_ACCESS_KEY=wellms_svc
S3_SECRET_KEY=

INITIAL_USER_EMAIL=admin@luminate.test
INITIAL_USER_PASSWORD=

JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_BASE64=

# HS256 key shared with the Luminate proxy for X-Tenant-Context (contract v3 §A.1). Rotate by moving the
# old value to _PREVIOUS, setting a new current key on both sides, then clearing _PREVIOUS.
TENANT_CONTEXT_KEY=
LUMINATE_WEBHOOK_SECRET=
PGBOUNCER_ADMIN_PASSWORD=
TENANT_CONTEXT_KEY_PREVIOUS=
