{
	auto_https off

	# Caddy's access and error logs include full request headers. Never write credentials to logs.
	log {
		format filter {
			wrap console
			request>headers>Authorization delete
			request>headers>X-Tenant-Context delete
			request>headers>Cookie delete
		}
	}
}

# API only. The Luminate proxy is the sole caller (server-to-server), so no CORS headers.
:80 {
	encode zstd gzip
	reverse_proxy api:9000 {
		transport fastcgi {
			env SCRIPT_FILENAME /var/www/html/index.php
		}
	}
}
